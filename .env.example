# SeedIQ Server Configuration Template
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
PORT=5000

# Gmail SMTP Configuration for Verification OTPs
GMAIL_SENDER_EMAIL=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-16-char-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Database Configuration
DATABASE_URL=sqlite:///seediq.db
