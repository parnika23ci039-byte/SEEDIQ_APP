# ==============================================================================
# SeedIQ Environment Configuration
# ==============================================================================

# Flask Session Security Key
FLASK_SECRET_KEY=seediq_super_secret_quantum_key_2026

# Fixed Privileged Account Email Identities
# (Administrators and Researchers access the app via standard Gmail OTP using these addresses)
SEEDIQ_ADMIN_EMAIL=admin@seediq.ai
SEEDIQ_RESEARCHER_EMAIL=researcher@quantum.org

# Real Gmail SMTP Dispatcher Credentials
# (Set these to send live 6-digit verification codes to real Gmail inboxes)
# Note: For Gmail, create an App Password at: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
