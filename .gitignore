# ── Generated mobile build output (never upload) ─────────────────────────────
# Any APK/AAB anywhere in the tree, including deliverables/ and expo build output.
*.apk
*.aab
*.apks
/deliverables/

# Expo native projects are generated by `npx expo prebuild` from app.json and
# the config plugins, and the checked-in copies carry ~2.5 GB of Gradle/Xcode
# build output. Source of truth is seediq-mobile/app.json + app/ + src/.
/seediq-mobile/android/
/seediq-mobile/ios/
/seediq-mobile/dist/
/seediq-mobile/deliverables/
/seediq-mobile/.expo/
/seediq-mobile/.expo-cache/
/seediq-mobile/.watchman-state/
/seediq-mobile/.gradle/

# Local one-off Railway deploy mirror; the canonical deployment config lives in
# Procfile, render.yaml, vercel.json and supabase/ at the repo root.
/.railway-deploy/

# Experiment model artifacts above GitHub's 100 MB hard limit. The artifacts the
# app actually serves stay tracked in SeedIQ/models/.
/experiments/improved_dataset/models/

# Local caches / scratch
.pytest_cache/

# Not a dataset: a saved Kaggle HTML page (and the public browser key embedded in
# that page). Excluded so no credential-like string ships with the repo.
/experiments/ml_optimization/india_agriculture.csv
